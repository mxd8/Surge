#!name=Sex8 去广告
#!desc=拦截 Sex8（Discuz 论坛）广告：站内广告接口 api.php?mod=ad（楼层横幅/弹窗卡片/APP 推广浮窗的投放源）+ 第三方推送域（热门标签接口会携带用户凭证请求随机域名、弹窗外链 tyughj.bar / bxkfw458.co）+ AdSense 与 GA/GTM 统计；重写页面删除广告弹窗容器（modal_index/modal_radio）、楼层广告、底部固定横幅、APP 推广浮窗、右下角悬浮视频广告窗、帖子内插入的广告行与返利推广挂件、会员订单通知弹窗，并给页面加 no-cache 防止旧缓存渲染出广告。附件/图片 CDN（x5ewt.com）与论坛功能不受影响。Mac 与 iOS 通用，需 MITM。
#!version=1.0.6
#!author=mxd8
#!date=2026-10-25

# 域名来源：surge-cli Replica 抓包（浏览器实访 forum.html）+ 渲染后 DOM 结构分析（2026-10-25）
# curl 直抓被站点 UA/TLS 指纹闸门拦（返回"请升级浏览器"壳页），证据全部来自浏览器实访
# 广告形态：全站第一方投放——api.php?mod=ad&adid=custom_* 脚本回填 xb_ad_source_* 卡片与
#           固定底部横幅；modal_index/modal_radio 弹窗外链指向随机域名（tyughj.bar 等，会轮换）；
#           楼层广告 .floor-ad 创意图直接走内容 CDN images.x5ewt.com（同域混用，只能删 DOM）。
#           v1.0.1 补（帖子页实抓）：右下角悬浮视频窗 .V-video-float（自动播放站内视频）、
#           帖子表格插入的广告行 tr.ad/.b_sxp（创意图同样走内容 CDN）、帖子内容区注入的
#           返利挂件 plugin-e6-rebate iframe/#v_e6_action、会员订单通知弹窗 member-order-notice；
#           重写同时给 HTML 响应加 Cache-Control: no-cache——MITM 关闭期间浏览器缓存的旧页面
#           会在恢复后继续渲染广告（无响应体可改写），加头后每次导航都拿到改写后的页面。
#           v1.0.2 补（多页实抓）：全站推广链接块 .full > .div-list（class 混淆随机串 fnwehjnc12
#           会轮换，用结构 :has 与内容类删）、Discuz 导航 #nv 里的推广 li（随机 id mn_N9660，
#           重写内按落地域 TLD/家族名过滤而非枚举 id）。
#           v1.0.3 补（可疑 JS 分析：MutationObserver 从 document_start 记录注入 + 脚本清单，
#           站点按请求轮换干净/带广告变体，循环多刷命中脏变体取证）：两侧悬浮条里的推广按钮
#           #qd-jdcf（右侧 qd-top 功能条保留只删广告按钮）、分组间滚动推广轮播（swiper 内
#           scroll-panel/pitem，gohome_* 类链接全指向落地域）；生成器是同源脚本
#           static/js/peerclick.js（gopeerclick.com 点击网络）与根目录 recommends.js
#           （mnoas309.com 广告 feed）——域名拦不了同源 JS，重写里正则摘除 script 标签断种，
#           运行时残留由新选择器清理；左侧 #location_list（categories.js 驱动的分类快捷条）
#           是站点功能，保留。
#           v1.0.4 补（用户实抓页面 HTML）：分组间横幅块 div.bm.b_sxc（595x80 GIF 创意图
#           走内容 CDN x5ewt.com，类名后缀 b_sxp/b_sxc 轮换，用 [class*="b_sx"] 通配）；
#           dasp.php 纯广告跳转器整条 URL-REGEX 拦（含裸 IP 落地 23.225.52.67 的出口）；
#           滚动轮播清空后的 swiper 空壳（35px 占位条）用 :has 连壳删。
#           script-path 加 ?v=1004 穿透 raw CDN 边缘缓存（改脚本必改 query，防拉到旧版）。
# 不误伤补充：帖子正文内嵌 video.js 播放器（#my_video_1 在 .t_f 单元格）的 HLS 源
#           media-server.baihu368.today / t7ggv.com 是用户发布的视频内容，绝不拦；
#           twitter.com / t.me 官方社媒链接与姊妹站 s8youni.com 保留。
# 不误伤：images/photos.x5ewt.com 是附件与头像 CDN（46+ 请求实测），绝不能加 DOMAIN-SUFFIX；
#           .p_pop/.h_pop 是 Discuz 弹出菜单不是广告；签到弹窗 #sign-ad 保留（站点功能）

[Rule]
# —— 站内广告投放接口 ——
# 只拦 mod=ad 的响应（回填广告卡片的 JS），其他 api.php 调用（mod=js 等）不受影响
URL-REGEX,^https?:\/\/www\.sex8\.cc\/api\.php\?mod=ad,REJECT

# —— 第三方推送 / 弹窗外链域 ——
# kongsjieie.bar：热门标签推送接口（v2/tag/hot，随机域名且带用户 Authorization 头请求，拦掉仅损失热搜词推荐）
DOMAIN-SUFFIX,kongsjieie.bar,REJECT
# tyughj.bar：ad_first 弹窗外链目标（随机域名，随投放轮换）
DOMAIN-SUFFIX,tyughj.bar,REJECT

# —— 推广落地域（多页实抓 2026-10-25，随机 TLD 批量轮换；结构删除为主，域名规则兜底）——
# bxkfw458 家族：v1.0.0 拦 .co，v1.0.2 实抓已轮换成 .com；glksr3.com 同款 /s3/ 跳转路径
DOMAIN-SUFFIX,bxkfw458.co,REJECT
DOMAIN-SUFFIX,bxkfw458.com,REJECT
DOMAIN-SUFFIX,glksr3.com,REJECT
# 导航栏与推广块的落地页 / 追踪端
DOMAIN-SUFFIX,rkaflet.xyz,REJECT
DOMAIN-SUFFIX,szefdrh.xyz,REJECT
DOMAIN-SUFFIX,heiliao37.fyi,REJECT
DOMAIN-SUFFIX,yuelao26.space,REJECT
DOMAIN-SUFFIX,duoduomxm.xyz,REJECT
DOMAIN-SUFFIX,quibids2.xyz,REJECT
DOMAIN-SUFFIX,weiixedbi.life,REJECT
DOMAIN-SUFFIX,heisiyujie527.online,REJECT
DOMAIN-SUFFIX,xn--03-rm6cv95j.com,REJECT

# —— 同源广告生成器的服务端（v1.0.3 脚本分析发现；脚本本体在重写里源头摘除）——
# peerclick.js 回传的广告点击网络；recommends.js 拉取的广告 feed
DOMAIN-SUFFIX,gopeerclick.com,REJECT
DOMAIN-SUFFIX,mnoas309.com,REJECT
# 内联脚本注入的镜像/落地域
DOMAIN-SUFFIX,langxiinsng.life,REJECT

# —— 广告点击跳转器与 IP 落地域（v1.0.4，用户实抓分组横幅块）——
# dasp.php 是纯广告跳转器（a=Sxx&u=落地URL），无正经用途，整条拦
URL-REGEX,^https?:\/\/www\.sex8\.cc\/dasp\.php,REJECT
# 分组横幅块里出现的裸 IP 落地页
IP-CIDR,23.225.52.67/32,REJECT,no-resolve

# —— 广告创意 CDN（v1.0.6 实抓：版头横幅表全部用它，抽验 4 帖正文 0 命中，非共享 CDN）——
DOMAIN-SUFFIX,q4rtz.com,REJECT

# —— AdSense 与统计 ——
# pagead2.googlesyndication.com/adsbygoogle.js 实抓；doubleclick 为 GA 关联曝光域
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googletagmanager.com,REJECT
DOMAIN-SUFFIX,google-analytics.com,REJECT
# Cloudflare Web Analytics（站点埋点）
DOMAIN-SUFFIX,cloudflareinsights.com,REJECT

[Script]
# 页面重写：删除广告弹窗容器/楼层广告/底部横幅/APP 推广浮窗（创意图走内容 CDN，只能删 DOM）
sex8-rewrite = type=http-response, pattern=^https?:\/\/[^\/]*sex8\.cc\/, requires-body=1, script-path=https://raw.githubusercontent.com/mxd8/Surge/main/modules/sex8-adblock/js/sex8-rewrite.js?v=1006, timeout=10

[MITM]
# 模块 [MITM] hostname 覆盖其他模块的列表：保留 avjoy/xvideos 去广告模块与内置 router-com 模块所需域名
hostname = avjoy.me, *.avjoy.me, router.com, www.router.com, xvideos.com, *.xvideos.com, sex8.cc, *.sex8.cc
